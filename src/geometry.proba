import from "./geometry" geometry

fn emptyBoard() → ti8[8,8,8] {
    const ti8[] seed ← empty
    return seed.create(0, [8,8,8])
}

fn unmoved() → list<i8> {
    var list<i8> state ← empty
    for range 0‥512 const id { state.append(0) }
    return state
}

fn ordered(list<i32> targets, i32 origin) → bool {
    var i32 previous ← -1
    for from targets const id {
        if id ≤ previous or id < 0 or id ≥ 512 or id ≡ origin { return false }
        previous ← id
    }
    return true
}

describe "geometry" {
    test "center rook has the exact 21 axis cells" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[3,3,3]] ← 3
        const list<i32> targets ← geometry.previews(board, unmoved(), 219)
        const list<i32> expected ← [27,91,155,195,203,211,216,217,218,220,221,222,223,227,235,243,251,283,347,411,475]
        assert targets ≡ expected
        assert ordered(targets, 219)
    }
    test "center bishop has 39 plane cells and queen is the 60 cell union" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[3,3,3]] ← 4
        const list<i32> bishop ← geometry.previews(board, unmoved(), 219)
        assert bishop.length() ≡ 39
        assert bishop.contains(228)
        assert bishop.contains(282)
        assert bishop.contains(291)
        assert bishop.contains(0) ≡ false
        assert bishop.contains(292) ≡ false
        board[[3,3,3]] ← 3
        const list<i32> rook ← geometry.previews(board, unmoved(), 219)
        board[[3,3,3]] ← 2
        const list<i32> queen ← geometry.previews(board, unmoved(), 219)
        assert queen.length() ≡ 60
        for from bishop const id { assert queen.contains(id) }
        for from rook const id { assert queen.contains(id) }
        assert ordered(bishop, 219)
        assert ordered(queen, 219)
    }
    test "knight has all 24 signed permutations and king all 26 neighboring cells" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[3,3,3]] ← 5
        const list<i32> knight ← geometry.previews(board, unmoved(), 219)
        assert knight.length() ≡ 24
        const list<i32> witnesses ← [83, 90, 92, 99, 139, 153, 157, 171, 202, 204, 209, 213, 225, 229, 234, 236, 267, 281, 285, 299, 339, 346, 348, 355]
        assert knight ≡ witnesses
        board[[3,3,3]] ← 1
        const list<i32> king ← geometry.previews(board, unmoved(), 219)
        const list<i32> neighbors ← [146,147,148,154,155,156,162,163,164,210,211,212,218,220,226,227,228,274,275,276,282,283,284,290,291,292]
        assert king ≡ neighbors
        assert ordered(knight, 219)
        assert ordered(king, 219)
    }
    test "corner and edge witnesses stay in bounds" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[0,0,0]] ← 4
        assert geometry.previews(board, unmoved(), 0).length() ≡ 21
        board[[0,0,0]] ← 2
        assert geometry.previews(board, unmoved(), 0).length() ≡ 42
        board[[0,0,0]] ← 1
        const list<i32> cornerKing ← geometry.previews(board, unmoved(), 0)
        assert cornerKing ≡ ([1,8,9,64,65,72,73] ∷ list<i32>)
        board[[0,0,0]] ← 5
        assert geometry.previews(board, unmoved(), 0) ≡ ([10,17,66,80,129,136] ∷ list<i32>)
        board[[0,0,0]] ← 0
        board[[0,3,3]] ← 4
        assert geometry.previews(board, unmoved(), 216).length() ≡ 27
        board[[0,3,3]] ← 1
        assert geometry.previews(board, unmoved(), 216).length() ≡ 17
        board[[0,3,3]] ← 5
        assert geometry.previews(board, unmoved(), 216).length() ≡ 16
    }
    test "friendly and enemy ray blockers stop sliding in all three planes" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[3,3,3]] ← 2
        board[[5,3,3]] ← 6
        board[[1,3,3]] ← -6
        board[[5,5,3]] ← 6
        board[[1,1,3]] ← -6
        board[[5,3,5]] ← 6
        board[[1,3,1]] ← -6
        board[[3,5,5]] ← 6
        board[[3,1,1]] ← -6
        const list<i32> targets ← geometry.previews(board, unmoved(), 219)
        const list<i32> enemies ← [217,201,89,75]
        for from enemies const id { assert targets.contains(id) }
        const list<i32> excluded ← [221,222,216,237,246,192,349,414,24,363,435,3]
        for from excluded const id { assert not targets.contains(id) }
        assert ordered(targets, 219)
    }
    test "knights jump blockers but exclude friendly landings and capture enemies" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[3,3,3]] ← 5
        board[[4,3,3]] ← 6
        board[[3,4,3]] ← -6
        board[[5,4,3]] ← 6
        board[[1,2,3]] ← -6
        const list<i32> targets ← geometry.previews(board, unmoved(), 219)
        assert targets.length() ≡ 23
        assert not targets.contains(229)
        assert targets.contains(209)
        assert targets.contains(236)
        assert ordered(targets, 219)
    }
    test "white and black pawn axes captures and moved state are exact" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[3,3,3]] ← 6
        board[[2,4,3]] ← -6
        board[[4,3,4]] ← -6
        assert geometry.previews(board, unmoved(), 219) ≡ ([226,227,235,283,284,347] ∷ list<i32>)
        var list<i8> moved ← unmoved()
        moved[219] ← 1
        assert geometry.previews(board, moved, 219) ≡ ([226,227,283,284] ∷ list<i32>)
        board[[3,3,3]] ← -6
        board[[2,2,3]] ← 6
        board[[4,3,2]] ← 6
        assert geometry.previews(board, unmoved(), 219) ≡ ([91,155,156,203,210,211] ∷ list<i32>)
        assert geometry.previews(board, moved, 219) ≡ ([155,156,210,211] ∷ list<i32>)
    }
    test "pawn doubles need both clear cells and captures need occupied enemies" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[3,3,3]] ← 6
        board[[3,4,3]] ← -6
        board[[3,3,5]] ← 6
        board[[2,4,3]] ← 6
        assert geometry.previews(board, unmoved(), 219) ≡ ([283] ∷ list<i32>)
        board[[3,4,3]] ← 0
        board[[3,5,3]] ← -6
        assert geometry.previews(board, unmoved(), 219) ≡ ([227,283] ∷ list<i32>)
        board[[3,3,4]] ← -6
        assert geometry.previews(board, unmoved(), 219) ≡ ([227] ∷ list<i32>)
    }
    test "pawns at forward boundaries cannot wrap and combined rank tier is absent" {
        var ti8[8,8,8] board ← emptyBoard()
        board[[0,7,7]] ← 6
        board[[1,0,0]] ← -6
        assert geometry.previews(board, unmoved(), 504).is_empty()
        assert geometry.previews(board, unmoved(), 1).is_empty()
        board[[0,7,7]] ← 0
        board[[1,0,0]] ← 0
        board[[3,6,6]] ← 6
        board[[4,7,7]] ← -6
        assert geometry.previews(board, unmoved(), 435) ≡ ([443,499] ∷ list<i32>)
        board[[3,6,6]] ← 0
        board[[4,7,7]] ← 0
        board[[3,1,1]] ← -6
        assert geometry.previews(board, unmoved(), 75) ≡ ([11,67] ∷ list<i32>)
    }
    test "empty invalid queries and all piece calculations leave inputs unchanged" {
        var ti8[8,8,8] board ← emptyBoard()
        var list<i8> moved ← unmoved()
        assert geometry.previews(board, moved, -1).is_empty()
        assert geometry.previews(board, moved, 512).is_empty()
        assert geometry.previews(board, moved, 219).is_empty()
        const list<i8> missing ← empty
        assert geometry.previews(board, missing, 219).is_empty()
        const list<i8> kinds ← [1,2,3,4,5,6]
        for from kinds const kind {
            board[[3,3,3]] ← kind
            board[[4,3,3]] ← -6
            moved[219] ← 1
            const list<i32> targets ← geometry.previews(board, moved, 219)
            assert ordered(targets, 219)
            for range 0‥8 const f {
                for range 0‥8 const r {
                    for range 0‥8 const t {
                        var i8 expected ← 0
                        if f ≡ 3 and r ≡ 3 and t ≡ 3 { expected ← kind }
                        if f ≡ 4 and r ≡ 3 and t ≡ 3 { expected ← -6 }
                        assert board[[f,r,t]] ≡ expected
                    }
                }
            }
            for range 0‥512 const id {
                if id ≡ 219 { assert moved[id] ≡ 1 } else { assert moved[id] ≡ 0 }
            }
        }
    }
}
