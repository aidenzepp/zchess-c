import from "./match" game
import from "./geometry" geometry
import from "./attacks" threats

@ public
class Move {
    var i32 to
    var string kind
    var list<i32> promotions
}

@ public
class Outcome {
    var string error
    var list<game.Match> values
}

fn rejected(string code) → Outcome {
    const list<game.Match> values ← empty
    return Outcome { error = code, values = values }
}

fn accepted(game.Match value) → Outcome {
    return Outcome { error = "", values = [adjudicate(value)] }
}

@ public
fn kingCell(game.Match value, i32 side) → i32 {
    for range 0‥512 const id {
        const i8 piece ← game.piece(value,id)
        if side ≡ 1 and piece ≡ 1 { return id }
        if side ≡ -1 and piece ≡ -1 { return id }
    }
    return -1
}

@ public
fn inCheck(game.Match value, i32 side) → bool {
    const i32 king ← kingCell(value,side)
    if king < 0 { return true }
    return threats.attacked(value,king,-side)
}

@ public
fn promotes(i8 piece, i32 to) → bool {
    if piece ≡ 6 { return (to / 8) % 8 ≡ 7 and to / 64 ≡ 7 }
    if piece ≡ -6 { return (to / 8) % 8 ≡ 0 and to / 64 ≡ 0 }
    return false
}

fn clearEntitlements(game.Match value, i8 piece, i32 cell) → void {
    if piece ≡ 1 {
        game.clearRight(value,0)
        game.clearRight(value,1)
    }
    if piece ≡ -1 {
        game.clearRight(value,2)
        game.clearRight(value,3)
    }
    if piece ≡ 3 and cell ≡ 0 { game.clearRight(value,0) }
    if piece ≡ 3 and cell ≡ 7 { game.clearRight(value,1) }
    if piece ≡ -3 and cell ≡ 504 { game.clearRight(value,2) }
    if piece ≡ -3 and cell ≡ 511 { game.clearRight(value,3) }
}

# This effect primitive is internal to rule validation. Special rules supply
# their captured/rook cells, then use the same complete candidate safety query.
@ public
fn construct(game.Match value, i32 from, i32 to, i32 promotion, i32 captured, i32 rookFrom, i32 rookTo) → game.Match {
    var game.Match candidate ← game.copy(value)
    const i8 piece ← game.piece(value,from)
    clearEntitlements(candidate,piece,from)
    if captured ≥ 0 {
        clearEntitlements(candidate,game.piece(value,captured),captured)
        game.put(candidate,captured,0)
        candidate.moved[captured] ← 0
    }
    game.put(candidate,from,0)
    candidate.moved[from] ← 0
    var i8 placed ← piece
    const list<i8> kinds ← [0,0,2,3,4,5]
    if promotion ≥ 2 and promotion ≤ 5 {
        placed ← kinds[promotion]
        if piece < 0 { placed ← -placed }
    }
    game.put(candidate,to,placed)
    candidate.moved[to] ← 1
    if rookFrom ≥ 0 {
        const i8 rook ← game.piece(value,rookFrom)
        game.put(candidate,rookFrom,0)
        candidate.moved[rookFrom] ← 0
        game.put(candidate,rookTo,rook)
        candidate.moved[rookTo] ← 1
    }
    game.clearEnPassant(candidate)
    if piece ≡ 6 or piece ≡ -6 {
        const i32 difference ← to - from
        if difference ≡ 16 or difference ≡ -16 {
            const i32 target ← from + game.side(value) * 8
            game.setEnPassant(candidate,target,to,1)
        }
        if difference ≡ 128 or difference ≡ -128 {
            const i32 target ← from + game.side(value) * 64
            game.setEnPassant(candidate,target,to,2)
        }
    }
    game.setLastMove(candidate,from,to,promotion)
    game.setSide(candidate,-game.side(value))
    game.setRevision(candidate,game.revision(value) + 1)
    return candidate
}

@ public
fn safe(game.Match candidate, i32 movingSide) → bool {
    return not inCheck(candidate,movingSide)
}

fn normalAllowed(game.Match value, i32 from, i32 to, i32 promotion) → bool {
    const i8 target ← game.piece(value,to)
    if target ≡ 1 or target ≡ -1 { return false }
    if not geometry.previews(value.board,value.moved,from).contains(to) { return false }
    const game.Match candidate ← construct(value,from,to,promotion,to,-1,-1)
    return safe(candidate,game.side(value))
}

fn enPassantEligible(game.Match value, i32 from, i32 to) → bool {
    if to ≢ game.epTarget(value) or to < 0 or to > 511 { return false }
    const i32 captured ← game.epCaptured(value)
    const i32 axis ← game.epAxis(value)
    if captured < 0 or captured > 511 or (axis ≢ 1 and axis ≢ 2) { return false }
    const i32 side ← game.side(value)
    const i8 piece ← game.piece(value,from)
    if side ≡ 1 and piece ≢ 6 { return false }
    if side ≡ -1 and piece ≢ -6 { return false }
    if game.piece(value,to) ≢ 0 or value.moved[captured] ≢ 1 { return false }
    if side ≡ 1 and game.piece(value,captured) ≢ -6 { return false }
    if side ≡ -1 and game.piece(value,captured) ≢ 6 { return false }
    const i32 fileDifference ← to % 8 - from % 8
    if fileDifference ≢ -1 and fileDifference ≢ 1 { return false }
    var i32 offset ← 8
    if axis ≡ 1 {
        if to / 64 ≢ from / 64 { return false }
        const i32 rankDifference ← (to / 8) % 8 - (from / 8) % 8
        if rankDifference ≢ side { return false }
    } else {
        offset ← 64
        if (to / 8) % 8 ≢ (from / 8) % 8 { return false }
        const i32 tierDifference ← to / 64 - from / 64
        if tierDifference ≢ side { return false }
    }
    const i32 expectedCaptured ← to - side * offset
    const i32 priorSource ← to + side * offset
    if captured ≢ expectedCaptured or priorSource < 0 or priorSource > 511 { return false }
    if game.piece(value,priorSource) ≢ 0 { return false }
    if game.lastFrom(value) ≢ priorSource or game.lastTo(value) ≢ captured or game.lastPromotion(value) ≢ 0 { return false }
    return true
}

fn enPassantAllowed(game.Match value, i32 from, i32 to) → bool {
    if not enPassantEligible(value,from,to) { return false }
    const game.Match candidate ← construct(value,from,to,0,game.epCaptured(value),-1,-1)
    return safe(candidate,game.side(value))
}

fn castleRook(game.Match value, i32 from, i32 to) → i32 {
    const i32 side ← game.side(value)
    var i32 base ← 0
    var i8 king ← 1
    var i8 rook ← 3
    var i32 rightBase ← 0
    if side ≡ -1 {
        base ← 504
        king ← -1
        rook ← -3
        rightBase ← 2
    }
    const i32 kingStart ← base + 4
    const i32 queenTarget ← base + 2
    const i32 kingTarget ← base + 6
    if from ≢ kingStart or game.piece(value,from) ≢ king or value.moved[from] ≢ 0 { return -1 }
    var i32 rookCell ← -1
    var i32 rightIndex ← rightBase
    if to ≡ queenTarget {
        rookCell ← base
        for range 1‥4 const file {
            if game.piece(value,base + file) ≢ 0 { return -1 }
        }
    }
    if to ≡ kingTarget {
        rookCell ← base + 7
        rightIndex ← rightBase + 1
        for range 5‥7 const file {
            if game.piece(value,base + file) ≢ 0 { return -1 }
        }
    }
    if rookCell < 0 or not game.right(value,rightIndex) { return -1 }
    if game.piece(value,rookCell) ≢ rook or value.moved[rookCell] ≢ 0 { return -1 }
    return rookCell
}

fn castleAllowed(game.Match value, i32 from, i32 to) → bool {
    const i32 rook ← castleRook(value,from,to)
    if rook < 0 or inCheck(value,game.side(value)) { return false }
    var i32 transit ← from + 1
    var i32 rookTo ← from + 1
    if to < from {
        transit ← from - 1
        rookTo ← from - 1
    }
    # The original rook stays put while checking the intermediate king square.
    const game.Match intermediate ← construct(value,from,transit,0,transit,-1,-1)
    if not safe(intermediate,game.side(value)) { return false }
    const game.Match final ← construct(value,from,to,0,-1,rook,rookTo)
    return safe(final,game.side(value))
}

fn candidateTargets(game.Match value, i32 selected) → list<i32> {
    var list<i32> targets ← geometry.previews(value.board,value.moved,selected)
    const i32 skipped ← game.epTarget(value)
    if enPassantEligible(value,selected,skipped) { targets.append(skipped) }
    const i32 queenCastle ← selected - 2
    const i32 kingCastle ← selected + 2
    if castleRook(value,selected,queenCastle) ≥ 0 { targets.append(queenCastle) }
    if castleRook(value,selected,kingCastle) ≥ 0 { targets.append(kingCastle) }
    targets.sort()
    return targets
}

fn classify(game.Match value, i32 selected, i32 to, bool firstOnly) → list<Move> {
    var list<Move> options ← empty
    var string kind ← "move"
    var bool admitted ← false
    var list<i32> promotions ← empty
    if castleAllowed(value,selected,to) {
        kind ← "castle"
        admitted ← true
    } else {
        if enPassantAllowed(value,selected,to) {
            kind ← "en-passant"
            admitted ← true
        } else {
            if promotes(game.piece(value,selected),to) {
                for range 2‥6 const choice {
                    if normalAllowed(value,selected,to,choice) {
                        promotions.append(choice)
                        if firstOnly { break }
                    }
                }
                admitted ← promotions.length() > 0
            } else {
                admitted ← normalAllowed(value,selected,to,0)
            }
            if game.piece(value,to) ≢ 0 { kind ← "capture" }
        }
    }
    if admitted { options.append(Move { to = to, kind = kind, promotions = promotions }) }
    return options
}

@ public
fn moves(game.Match value, i32 selected) → list<Move> {
    var list<Move> options ← empty
    if selected < 0 or selected > 511 or game.result(value) ≢ 0 { return options }
    if game.color(game.piece(value,selected)) ≢ game.side(value) { return options }
    for from candidateTargets(value,selected) const to {
        for from classify(value,selected,to,false) const option { options.append(option) }
    }
    return options
}

@ public
fn hasReply(game.Match value) → bool {
    if game.result(value) ≢ 0 { return false }
    for range 0‥512 const selected {
        if game.color(game.piece(value,selected)) ≡ game.side(value) {
            for from candidateTargets(value,selected) const to {
                if classify(value,selected,to,true).length() > 0 { return true }
            }
        }
    }
    return false
}

@ public
fn adjudicate(game.Match value) → game.Match {
    var game.Match next ← game.copy(value)
    game.setResult(next,0)
    if not hasReply(next) {
        if inCheck(next,game.side(next)) {
            if game.side(next) ≡ 1 { game.setResult(next,2) } else { game.setResult(next,1) }
        } else {
            game.setResult(next,3)
        }
    }
    return next
}

@ public
fn move(game.Match value, i32 expectedRevision, i32 from, i32 to, i32 promotion) → Outcome {
    if expectedRevision ≢ game.revision(value) { return rejected("STALE_REVISION") }
    if game.result(value) ≢ 0 { return rejected("GAME_OVER") }
    if not game.canIncrement(value) { return rejected("REVISION_EXHAUSTED") }
    if from < 0 or from > 511 or to < 0 or to > 511 { return rejected("INVALID_REQUEST") }
    const i8 piece ← game.piece(value,from)
    if piece ≡ 0 { return rejected("ILLEGAL_MOVE") }
    if game.color(piece) ≢ game.side(value) { return rejected("NOT_YOUR_TURN") }
    if castleAllowed(value,from,to) {
        if promotion ≢ 0 { return rejected("INVALID_PROMOTION") }
        var i32 rookTo ← from + 1
        if to < from { rookTo ← from - 1 }
        return accepted(construct(value,from,to,0,-1,castleRook(value,from,to),rookTo))
    }
    if enPassantAllowed(value,from,to) {
        if promotion ≢ 0 { return rejected("INVALID_PROMOTION") }
        return accepted(construct(value,from,to,0,game.epCaptured(value),-1,-1))
    }
    if promotes(piece,to) {
        if not normalAllowed(value,from,to,2) { return rejected("ILLEGAL_MOVE") }
        if promotion ≡ 0 { return rejected("PROMOTION_REQUIRED") }
        if promotion < 2 or promotion > 5 { return rejected("INVALID_PROMOTION") }
        if not normalAllowed(value,from,to,promotion) { return rejected("ILLEGAL_MOVE") }
        return accepted(construct(value,from,to,promotion,to,-1,-1))
    }
    if not normalAllowed(value,from,to,0) { return rejected("ILLEGAL_MOVE") }
    if promotion ≢ 0 { return rejected("INVALID_PROMOTION") }
    return accepted(construct(value,from,to,0,to,-1,-1))
}
