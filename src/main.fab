import from "./arena" arena

@ cli { name = "zchess" }
@ operand { type = string, binding = fixture, description = "Fixture identifier" }
@ operand { type = string, binding = selected, description = "Selected cell, or -1" }
main args args {
    const i32 selected ← args.selected ↦ i32
    print arena.snapshot(args.fixture, selected)
}
