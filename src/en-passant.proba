import from "./match" game
import from "./rules" rules

fn eligible(i32 side, i32 axis) → game.Match {
    var game.Match value ← game.blank()
    game.put(value,4,1)
    game.put(value,508,-1)
    game.setSide(value,-side)
    var i32 offset ← 8
    if axis ≡ 2 { offset ← 64 }
    const i32 source ← 219 + side * offset
    const i32 captured ← 219 - side * offset
    if side ≡ 1 {
        game.put(value,source,-6)
        game.put(value,captured - 1,6)
    } else {
        game.put(value,source,6)
        game.put(value,captured - 1,-6)
    }
    const rules.Outcome double ← rules.move(value,0,source,captured,0)
    assert double.error ≡ ""
    return double.values[0]
}

fn descriptor(game.Match value, i32 source, i32 to) → string {
    for from rules.moves(value,source) const option {
        if option.to ≡ to {
            assert option.promotions.length() ≡ 0
            return option.kind
        }
    }
    return "absent"
}

fn rejected(game.Match value, i32 source, i32 to, i32 promotion, string code) → void {
    const string before ← game.encode(value)
    const rules.Outcome result ← rules.move(value,game.revision(value),source,to,promotion)
    assert result.error ≡ code
    assert result.values.length() ≡ 0
    assert game.encode(value) ≡ before
}

describe "en-passant" {
    test "both colors and both double axes capture the recorded pawn atomically" {
        const list<i32> sides ← [1,-1]
        for range 0‥2 const color {
            for range 1‥3 const axis {
                const game.Match value ← eligible(sides[color],axis)
                const i32 captured ← game.epCaptured(value)
                const i32 source ← captured - 1
                const string before ← game.encode(value)
                assert descriptor(value,source,219) ≡ "en-passant"
                const rules.Outcome result ← rules.move(value,1,source,219,0)
                assert result.error ≡ ""
                const game.Match next ← result.values[0]
                assert game.piece(next,captured) ≡ 0
                assert next.moved[captured] ≡ 0
                assert game.piece(next,source) ≡ 0
                assert next.moved[source] ≡ 0
                assert game.color(game.piece(next,219)) ≡ sides[color]
                assert next.moved[219] ≡ 1
                assert game.epTarget(next) ≡ -1
                assert game.epCaptured(next) ≡ -1
                assert game.epAxis(next) ≡ -1
                assert game.revision(next) ≡ 2
                const i32 nextSide ← -sides[color]
                assert game.side(next) ≡ nextSide
                assert game.lastFrom(next) ≡ source
                assert game.lastTo(next) ≡ 219
                assert game.lastPromotion(next) ≡ 0
                assert game.validate(game.encode(next)) ≡ "OK"
                assert game.encode(value) ≡ before
            }
        }
    }
    test "either file flank is legal but perpendicular interception is excluded" {
        var game.Match rank ← eligible(1,1)
        game.put(rank,212,6)
        assert descriptor(rank,212,219) ≡ "en-passant"
        game.put(rank,154,6)
        assert descriptor(rank,154,219) ≡ "absent"
        rejected(rank,154,219,0,"ILLEGAL_MOVE")
        var game.Match tier ← eligible(-1,2)
        game.put(tier,228,-6)
        assert descriptor(tier,228,219) ≡ "absent"
        rejected(tier,228,219,0,"ILLEGAL_MOVE")
    }
    test "bad recorded pawn target axis or previous move cannot fabricate a capture" {
        var game.Match value ← eligible(1,1)
        game.put(value,211,3)
        rejected(value,210,219,0,"ILLEGAL_MOVE")
        game.put(value,211,-6)
        value.moved[211] ← 0
        rejected(value,210,219,0,"ILLEGAL_MOVE")
        value.moved[211] ← 1
        game.setLastMove(value,228,211,0)
        rejected(value,210,219,0,"ILLEGAL_MOVE")
        game.setLastMove(value,227,211,0)
        game.setEnPassant(value,219,211,2)
        rejected(value,210,219,0,"ILLEGAL_MOVE")
        game.clearEnPassant(value)
        rejected(value,210,219,0,"ILLEGAL_MOVE")
    }
    test "reads and rejected promotion intent preserve the entitlement" {
        const game.Match value ← eligible(1,1)
        const string before ← game.encode(value)
        assert descriptor(value,210,219) ≡ "en-passant"
        assert game.encode(value) ≡ before
        rejected(value,210,219,2,"INVALID_PROMOTION")
        assert game.epTarget(value) ≡ 219
        const rules.Outcome result ← rules.move(value,1,210,219,0)
        assert result.error ≡ ""
    }
    test "another committed move expires it and a later interception fails" {
        const game.Match value ← eligible(1,1)
        const rules.Outcome other ← rules.move(value,1,4,12,0)
        assert other.error ≡ ""
        const game.Match after ← other.values[0]
        assert game.epTarget(after) ≡ -1
        const rules.Outcome reply ← rules.move(after,2,508,500,0)
        assert reply.error ≡ ""
        rejected(reply.values[0],210,219,0,"ILLEGAL_MOVE")
    }
    test "a new double replaces the prior entitlement with its own axis" {
        var game.Match value ← eligible(1,1)
        game.put(value,300,6)
        const rules.Outcome result ← rules.move(value,1,300,428,0)
        assert result.error ≡ ""
        const game.Match next ← result.values[0]
        assert game.epTarget(next) ≡ 364
        assert game.epCaptured(next) ≡ 428
        assert game.epAxis(next) ≡ 2
        assert game.validate(game.encode(next)) ≡ "OK"
    }
    test "removed captured pawn can expose a cross tier diagonal check" {
        var game.Match value ← game.blank()
        game.put(value,139,1)
        game.put(value,508,-1)
        game.put(value,427,-4)
        game.put(value,283,-6)
        value.moved[283] ← 1
        game.put(value,282,6)
        game.setEnPassant(value,347,283,2)
        game.setLastMove(value,411,283,0)
        game.setRevision(value,1)
        assert game.validate(game.encode(value)) ≡ "OK"
        assert not rules.inCheck(value,1)
        assert descriptor(value,282,347) ≡ "absent"
        rejected(value,282,347,0,"ILLEGAL_MOVE")
    }
    test "removing the checking pawn is a valid check evasion" {
        var game.Match value ← game.blank()
        game.put(value,218,1)
        game.put(value,508,-1)
        game.put(value,283,-6)
        value.moved[283] ← 1
        game.put(value,282,6)
        game.setEnPassant(value,347,283,2)
        game.setLastMove(value,411,283,0)
        game.setRevision(value,1)
        assert rules.inCheck(value,1)
        const rules.Outcome result ← rules.move(value,1,282,347,0)
        assert result.error ≡ ""
        assert not rules.inCheck(result.values[0],1)
    }
}
